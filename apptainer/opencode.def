Bootstrap: docker
From: ubuntu:24.04

%arguments
    OPENCODE_DATA_DIR=/opt/opencode/share

%files
    share/AGENTS.md {{ OPENCODE_DATA_DIR }}/
    share/opencode.json {{ OPENCODE_DATA_DIR }}/

%post
    # Upgrade system packages.
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get upgrade -y

    # Install Node.js and OpenCode.
    apt-get install npm -y
    npm install -g opencode-ai

%environment
    export OPENCODE_CONFIG={{ OPENCODE_DATA_DIR }}/opencode.json

%test
    opencode --version

%runscript
    opencode $@
